sequenceDiagram
    actor Member
    actor Admin
    participant Record as Record <<database>>

    Member->>Admin: Request makeup session (date & location)

    loop Find suitable slot
        Admin-->>Record: Check capacity for requested time
        alt Capacity available
            Admin-->>Member: Send confirmation request
            Member-->>Admin: Confirm attendance
            Admin-->>Record: Book session
        else No capacity
            Admin-->>Member: Provide alternative dates/times
        end
    end
    Admin-->>Member: Send final confirmation with details
